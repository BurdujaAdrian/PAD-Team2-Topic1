              "mode": "raw",
              "raw": "{\n  \"text\": \"What makes an operation idempotent?\",\n  \"options\": [\n    {\n      \"option_id\": \"opt-a\",\n      \"text\": \"Repeating it changes nothing\"\n    },\n    {\n      \"option_id\": \"opt-b\",\n      \"text\": \"It runs in constant time\"\n    }\n  ],\n  \"correct_option_id\": \"opt-a\"\n}",
              "options": {
