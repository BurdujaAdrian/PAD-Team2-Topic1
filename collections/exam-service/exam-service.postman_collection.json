        {
          "name": "Finish the exam",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/exams/attempts/{{attemptId}}/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "exams",
                "attempts",
                "{{attemptId}}",
                "submit"
              ]
            },
            "description": "Scores the attempt, publishes `exam_passed` and `achievement_unlocked`, and returns the result.\n\nIdempotent: a second call returns the stored result and publishes nothing again. The `attempt_id` is what the World Service expects as `trigger_id` when unlocking a section.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"the exam was passed with a perfect score\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.passed).to.be.true;",
                  "    pm.expect(body.score).to.eql(1);",
                  "});",
                  "pm.test(\"achievements were unlocked\", function () {",
                  "    pm.expect(pm.response.json().achievements_unlocked).to.include(\"perfect_score\");",
                  "});"
                ]
              }
            }
          ]
        },
