{
  "info": {
    "name": "Game Service",
    "description": "Requests for game-service. Set variables on the collection (Variables tab). The /live WebSocket endpoint (port 8081, needs a signed ticket unless ALLOW_INSECURE_WS=1) is not included: use websocat (see README).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "session_id",
      "value": ""
    },
    {
      "key": "action_id",
      "value": ""
    },
    {
      "key": "host_id",
      "value": "p1"
    },
    {
      "key": "player_id",
      "value": "p2"
    },
    {
      "key": "map_id",
      "value": "map1"
    },
    {
      "key": "action_type",
      "value": "scavenge"
    },
    {
      "key": "room_id",
      "value": "room1"
    }
  ],
  "item": [
    {
      "name": "Service status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/status",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "status"
          ]
        }
      }
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "List sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/sessions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            }
          }
        },
        {
          "name": "Create session (host auto-joins)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/sessions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"host_player_id\": \"{{host_id}}\",\n  \"map_id\": \"{{map_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Auto-saves session_id (skipped silently if scripts aren't supported)",
                  "try {",
                  "  const j = pm.response.json();",
                  "  if (j.session_id) pm.collectionVariables.set('session_id', j.session_id);",
                  "} catch (e) {}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/sessions/{{session_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{session_id}}"
              ]
            }
          }
        },
        {
          "name": "Join session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/sessions/{{session_id}}/join",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{session_id}}",
                "join"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"player_id\": \"{{player_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Start session (host only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/sessions/{{session_id}}/start",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{session_id}}",
                "start"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"player_id\": \"{{host_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "End session (testing only)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/sessions/{{session_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{session_id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Actions",
      "item": [
        {
          "name": "Start timed action",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/sessions/{{session_id}}/actions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{session_id}}",
                "actions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"player_id\": \"{{host_id}}\",\n  \"type\": \"{{action_type}}\",\n  \"target_room_id\": \"{{room_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "type must be one of: chop, scavenge, clear_room, barricade, repair. Otherwise 400 'unknown action type'. Gathering actions (chop, scavenge) need target_room_id to have any effect."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const j = pm.response.json();",
                  "  if (j.action_id) pm.collectionVariables.set('action_id', j.action_id);",
                  "} catch (e) {}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get action status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/sessions/{{session_id}}/actions/{{action_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{session_id}}",
                "actions",
                "{{action_id}}"
              ]
            }
          }
        },
        {
          "name": "Cancel action",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/sessions/{{session_id}}/actions/{{action_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{session_id}}",
                "actions",
                "{{action_id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Zombies",
      "item": [
        {
          "name": "List zombies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/sessions/{{session_id}}/zombies",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{session_id}}",
                "zombies"
              ]
            }
          }
        }
      ]
    }
  ]
}
