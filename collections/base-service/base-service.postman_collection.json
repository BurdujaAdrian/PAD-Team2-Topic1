                {
                    "name": "Reinforce Room - Idempotent Replay",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                                    "const body = pm.response.json();",
                                    "pm.test(\"barricade_level is unchanged (still 1)\", () => pm.expect(body.barricade_level).to.eql(1));",
                                    "pm.test(\"no resources are spent on a replay\", () => pm.expect(body.resources_spent).to.eql({}));"
                                ]
                            }
