        {
            "name": "Kiki",
            "description": "Random reward interaction with a 60 second cooldown per base. Run these two requests back to back.",
            "item": [
                {
                    "name": "Kiki Interact",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                                    "const body = pm.response.json();",
                                    "pm.test(\"reward_type is a known reward\", () => {",
                                    "    pm.expect(body.reward_type).to.be.oneOf([\"booster\", \"resource_crate\", \"cosmetic_skin\", \"rare_blueprint\"]);",
                                    "});",
                                    "pm.test(\"reward is granted to the base owner\", () => {",
                                    "    pm.expect(body.granted_to).to.eql(pm.collectionVariables.get(\"playerId\"));",
                                    "    pm.expect(body.reward_id).to.be.a(\"string\").and.not.empty;",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
