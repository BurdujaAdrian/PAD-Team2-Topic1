{
    "info": {
        "_postman_id": "6f0c1f0e-5b1a-4a53-9a55-3c6a8f5b7d21",
        "name": "Base Service",
        "description": "Test collection for the Base Service (`services/base-service`).\n\nRun the folders top to bottom (or use the Collection Runner). **Bases > Create Base** creates a fresh base and stores its ids as collection variables that the later requests use; **Cleanup** deletes it.\n\nVariable `baseUrl` defaults to `http://localhost:5076` (the `dotnet run` port).",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Status",
            "description": "Health check.",
            "item": [
                {
                    "name": "Service Status",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                                    "const body = pm.response.json();",
                                    "pm.test(\"service is base and status is ok\", () => {",
                                    "    pm.expect(body.service).to.eql(\"base\");",
                                    "    pm.expect(body.status).to.eql(\"ok\");",
                                    "});",
                                    "pm.test(\"uptime_seconds is a non-negative number\", () => {",
                                    "    pm.expect(body.uptime_seconds).to.be.a(\"number\");",
                                    "    pm.expect(body.uptime_seconds).to.be.at.least(0);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/status",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "status"
                            ]
                        },
                        "description": "Health check. Returns the service name, `ok` status and uptime in seconds."
                    }
                }
            ]
        },
        {
            "name": "Bases",
            "description": "Create, read and update a base. Run the requests in order: Create Base stores `baseId`, `roomId` and `facilityId` as collection variables for every request after it.",
            "item": [
                {
                    "name": "Create Base",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.collectionVariables.set(\"playerId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"status is 201 Created\", () => pm.response.to.have.status(201));",
                                    "const body = pm.response.json();",
                                    "pm.test(\"Location header points to the new base\", () => {",
                                    "    pm.expect(pm.response.headers.get(\"Location\")).to.include(body.base_id);",
                                    "});",
                                    "pm.test(\"base belongs to the requested player\", () => {",
                                    "    pm.expect(body.player_id).to.eql(pm.collectionVariables.get(\"playerId\"));",
                                    "});",
                                    "pm.test(\"base is seeded with one starter room at barricade level 0\", () => {",
                                    "    pm.expect(body.rooms).to.have.lengthOf(1);",
                                    "    pm.expect(body.rooms[0].barricade_level).to.eql(0);",
                                    "});",
                                    "pm.test(\"base is seeded with one level 1 crafting_station\", () => {",
                                    "    pm.expect(body.facilities).to.have.lengthOf(1);",
                                    "    pm.expect(body.facilities[0].type).to.eql(\"crafting_station\");",
                                    "    pm.expect(body.facilities[0].level).to.eql(1);",
                                    "});",
                                    "pm.test(\"response has the expected fields\", () => {",
                                    "    pm.expect(body).to.have.all.keys(\"base_id\", \"player_id\", \"defense_score\", \"storage_capacity\", \"rooms\", \"facilities\");",
                                    "});",
                                    "pm.collectionVariables.set(\"baseId\", body.base_id);",
                                    "pm.collectionVariables.set(\"roomId\", body.rooms[0].room_id);",
                                    "pm.collectionVariables.set(\"facilityId\", body.facilities[0].facility_id);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/bases",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "bases"
                            ]
                        },
                        "description": "Creates a base for a player. Auto-seeds one starter room (barricade level 0) and one starter facility (`crafting_station`, level 1). Saves `baseId`, `roomId` and `facilityId` for the following requests.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"player_id\": \"{{playerId}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Get Base State",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                                    "const body = pm.response.json();",
                                    "pm.test(\"returns the created base\", () => {",
                                    "    pm.expect(body.base_id).to.eql(pm.collectionVariables.get(\"baseId\"));",
                                    "    pm.expect(body.player_id).to.eql(pm.collectionVariables.get(\"playerId\"));",
                                    "});",
                                    "pm.test(\"rooms and facilities are present\", () => {",
                                    "    pm.expect(body.rooms).to.be.an(\"array\").that.is.not.empty;",
                                    "    pm.expect(body.facilities).to.be.an(\"array\").that.is.not.empty;",
                                    "});",
                                    "pm.test(\"defense_score and storage_capacity are numbers\", () => {",
                                    "    pm.expect(body.defense_score).to.be.a(\"number\");",
                                    "    pm.expect(body.storage_capacity).to.be.a(\"number\");",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/bases/{{baseId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "bases",
                                "{{baseId}}"
                            ]
                        },
                        "description": "Returns the full current state of the base created by **Create Base**."
                    }
                },
                {
                    "name": "Update Base",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                                    "const body = pm.response.json();",
                                    "pm.test(\"storage_capacity was updated to 150\", () => pm.expect(body.storage_capacity).to.eql(150));",
                                    "pm.test(\"rooms and facilities are unchanged\", () => {",
                                    "    pm.expect(body.rooms).to.have.lengthOf(1);",
                                    "    pm.expect(body.facilities).to.have.lengthOf(1);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/bases/{{baseId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "bases",
                                "{{baseId}}"
                            ]
                        },
                        "description": "Updates mutable top-level base fields (currently `storage_capacity`).",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"storage_capacity\": 150\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    }
                }
            ]
        },
        {
            "name": "Rooms",
            "description": "Barricade reinforcement (max level 5). Resource costs come from the mocked Resource Service formula.",
            "item": [
                {
                    "name": "Reinforce Room",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.collectionVariables.set(\"requestId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                                    "const body = pm.response.json();",
                                    "pm.test(\"barricade_level is now 1\", () => {",
                                    "    pm.expect(body.room_id).to.eql(pm.collectionVariables.get(\"roomId\"));",
                                    "    pm.expect(body.barricade_level).to.eql(1);",
