                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"status is 429 Too Many Requests\", () => pm.response.to.have.status(429));",
                                    "pm.test(\"error is cooldown_active\", () => pm.expect(pm.response.json().error).to.eql(\"cooldown_active\"));",
                                    "pm.test(\"Retry-After header is between 1 and 60 seconds\", () => {",
