# Copy this file to .env and fill in real values. Never commit .env.

# Base Service database
BASE_POSTGRES_DB=base_db
BASE_POSTGRES_USER=base_user
BASE_POSTGRES_PASSWORD=change_me

# Crafting Service database
CRAFTING_POSTGRES_DB=crafting_db
CRAFTING_POSTGRES_USER=crafting_user
CRAFTING_POSTGRES_PASSWORD=change_me

# Zombie Service database 
ZOMBIE_POSTGRES_DB=zombie_db
ZOMBIE_POSTGRES_USER=zombie_user
ZOMBIE_POSTGRES_PASSWORD=change_me

# Resource Service database 
RESOURCE_POSTGRES_DB=resource_db
RESOURCE_POSTGRES_USER=resource_user
RESOURCE_POSTGRES_PASSWORD=change_me

# Exam Service database (rqlite)
# These must match secrets/exam-rqlite-users.json -- see secrets/README.md.
EXAM_RQLITE_USER=exam_user
EXAM_RQLITE_PASSWORD=change_me

# World Service database (rqlite)
# These must match secrets/world-rqlite-users.json -- see secrets/README.md.
WORLD_RQLITE_USER=world_user
WORLD_RQLITE_PASSWORD=change_me
