# Copy this file to .env and fill in real values. Never commit .env.

# Base Service database
BASE_POSTGRES_DB=base_db
BASE_POSTGRES_USER=base_user
BASE_POSTGRES_PASSWORD=change_me

# Crafting Service database
CRAFTING_POSTGRES_DB=crafting_db
CRAFTING_POSTGRES_USER=crafting_user
CRAFTING_POSTGRES_PASSWORD=change_me

# Zombie Service database 
ZOMBIE_POSTGRES_DB=zombie_db
ZOMBIE_POSTGRES_USER=zombie_user
ZOMBIE_POSTGRES_PASSWORD=change_me

# Resource Service database 
RESOURCE_POSTGRES_DB=resource_db
RESOURCE_POSTGRES_USER=resource_user
RESOURCE_POSTGRES_PASSWORD=change_me

# WebSocket tickets: the Gateway signs them and Game Service checks them, so
# both read this one value. Any long random string, e.g. openssl rand -hex 32
WS_TICKET_SECRET=change_me

# Discovery health alerts on Telegram: the bot's token from @BotFather and the
# group's chat id (from https://api.telegram.org/bot<token>/getUpdates). Leave both
# empty to only log the alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# System log download: use a long random value and send it in X-Log-Token to
# GET http://localhost:8600/logs. Empty disables downloads. Keep it out of Git.
LOG_DOWNLOAD_TOKEN=
# Host UDP port used by the Docker syslog logging driver.
SYSLOG_HOST_PORT=15514

# Password of Grafana's admin account (user: admin). The dashboard can be read
# without logging in; this is only needed to change it.
GRAFANA_ADMIN_PASSWORD=change_me

# Existing Broker repository spelling. Override the full path if your team's
# Docker Hub namespace differs; the local-build override works without pulling it.
BROKER_IMAGE=ion04/messege-broker:4.1.1-dev
