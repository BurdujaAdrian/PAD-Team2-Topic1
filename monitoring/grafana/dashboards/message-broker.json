        {
            "id": 18,
            "type": "timeseries",
            "title": "Open file descriptors",
            "description": "Mostly sockets: connections to services and from the Gateway. A steady climb is a leak.",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 16,
                "y": 34,
                "w": 8,
                "h": 7
            },
            "targets": [
                {
                    "refId": "A",
